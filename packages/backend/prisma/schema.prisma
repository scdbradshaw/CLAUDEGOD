// CLAUDE GOD — Prisma schema (Phase 1).
//
// Mirrors DESIGN.md sections:
//   §3.1, §13   World, City
//   §5          Person (real-person schema)
//   §5.4        LifeDecadeSummary
//   §5.5        Relationship
//   §6.4        World.market_index (global market)
//   §8.1        Group (factions + religions, single table)
//   §9.4        WorldEvent (active + archived)
//   §10         BiographyArchive
//   §12         Bucket
//   §15.2.1     YearRun (with random_seed for replay)
//
// Enums must mirror the unions in `packages/shared/src/types.ts`.
// The phase-1 roundtrip test guards parity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PersonType {
  Farmer
  Laborer
  Artisan
  Merchant
  Soldier
  Priest
  Scholar
  Noble
  Outlaw
  Healer
}

// Race is stored as String (not enum) because mixed races are
// "{race_a}-{race_b}" composites. Validation happens in shared types.

enum RegionResource {
  farmland
  coast
  mountains
  forest
  desert
  crossroads
}

enum GroupKind {
  faction
  religion
}

enum EventType {
  Plague
  Famine
  Fire
  Drought
  FactionWar
  CityRevolt
  Siege
  ReligiousSchism
  GoldenAge
  BountifulHarvest
  Discovery
  GreatCrash
}

enum EventEndReason {
  expired
  manual
  condition_met
  overridden
}

enum DeathCause {
  old_age
  health
  event
  interaction
  accident
}

enum YearRunStatus {
  pending
  running
  completed
  failed
}

// ─── World ───────────────────────────────────────────────────────────────────

model World {
  id                            String   @id @default(uuid())
  name                          String
  current_year                  Int      @default(0)

  // §6.4 — global market
  market_index                  Float    @default(1.0)
  market_trend                  Float    @default(0.0)

  // §15.2.1 — root seed for deterministic year runs
  random_seed_root              BigInt

  // §14.5 — opt-in flag; default OFF
  prejudice_against_same_sex    Boolean  @default(false)

  // §9.3 — short ring buffer (last 3 years) of per-city snapshots used by
  // cascade-trigger evaluation. Shape: WorldStateSnapshot[] (shared types).
  state_history                 Json     @default("[]")

  // §16.1.2 — last-100-year market index history for the WorldMap chart.
  // Shape: { year: number, market_index: number }[]
  market_index_history          Json     @default("[]")

  // §6.4 v2 — last-100-year stock-market class-signals history. Powers the
  // Market page charts (food ratio, class deltas, per-class pop/wealth).
  // Shape: MarketSignalsEntry[] (shared types).
  market_signals_history        Json     @default("[]")

  created_at                    DateTime @default(now())

  cities       City[]
  people       Person[]
  groups       Group[]
  events       WorldEvent[]
  year_runs    YearRun[]
  archives     BiographyArchive[]
}

// ─── City (§13) ──────────────────────────────────────────────────────────────

model City {
  id                    String          @id @default(uuid())
  world_id              String
  name                  String
  x                     Float
  y                     Float
  founded_year          Int
  is_ruined             Boolean         @default(false)

  // Snapshot rollups (year-end refresh)
  population_total      Int             @default(0)
  avg_wealth            Int             @default(0)
  mood_score            Float           @default(50)
  dominant_faction_id   String?
  dominant_religion_id  String?

  // Permanent identity
  region_resource       RegionResource

  // Governance
  defense_rating        Int             @default(50)
  treasury              Int             @default(0)
  mayor_id              String?
  tax_rate              Int             @default(10)         // 0–50 slider
  garrison_size         Int             @default(0)

  // Race relations — field exists, mechanic deferred to v1.1 (§14.3)
  prejudice_level       Int             @default(0)

  world                 World           @relation(fields: [world_id], references: [id], onDelete: Cascade)
  buckets               Bucket[]
  people                Person[]

  @@index([world_id])
}

// ─── Bucket (§12) ────────────────────────────────────────────────────────────
// Composite primary key (city_id, type). One row per (city × type).

model Bucket {
  city_id                  String
  type                     PersonType
  count                    Int        @default(0)

  // Demographics
  avg_age                  Float      @default(30)
  birth_rate               Float      @default(0.02)
  death_rate               Float      @default(0.018)
  race_shares              Json       @default("{}")

  // Stat averages (mirror Person numeric fields)
  avg_wealth               Int        @default(0)
  avg_intelligence         Float      @default(50)
  avg_combat               Float      @default(50)
  avg_health               Float      @default(80)
  avg_happiness            Float      @default(50)
  avg_sexuality            Float      @default(70)

  // Group affiliations (cap 5 entries each by convention)
  religion_shares          Json       @default("{}")
  faction_shares           Json       @default("{}")

  // Tag frequencies
  personality_tag_freqs    Json       @default("{}")
  state_tag_freqs          Json       @default("{}")

  city                     City       @relation(fields: [city_id], references: [id], onDelete: Cascade)

  @@id([city_id, type])
}

// ─── Person (§5) ─────────────────────────────────────────────────────────────

model Person {
  id                String   @id @default(uuid())
  world_id          String
  city_id           String
  type              PersonType
  faction_id          String?
  religion_id         String?
  faction_joined_year Int?
  religion_joined_year Int?

  // Identity
  name              String
  age               Int
  gender            String                       // 'male' | 'female' | 'nonbinary'
  race              String                       // Race or `${Race}-${Race}` mixed
  sexuality         Int                          // 0=fully gay, 100=fully straight
  is_alive          Boolean   @default(true)
  death_year        Int?
  death_cause       DeathCause?
  created_year      Int

  // Stats
  combat            Int       @default(50)
  intelligence      Int       @default(50)
  happiness         Int       @default(50)
  wealth            Int       @default(0)
  current_health    Int       @default(100)

  // Tags (jsonb arrays — string[] of PersonalityTag, { tag, set_year }[] of StateTag)
  personality_tags  Json      @default("[]")
  state_tags        Json      @default("[]")

  // Memory + queued actions (§5.4, §11.4)
  recent_memories   Json      @default("[]")
  action_queue      Json      @default("[]")

  // Kin
  spouse_id         String?
  mother_id         String?
  father_id         String?

  // Player control + churn bookkeeping
  is_pinned         Boolean   @default(false)
  last_event_year   Int?                          // for §4.3 demotion-grace check

  // §6.3 dues — consecutive missed-payment counters; reset on payment.
  // Reaching DUES_KICK_AFTER_MISSES expels the member from the group
  // (factions only; religions don't kick the broke).
  dues_missed_faction   Int   @default(0)
  dues_missed_religion  Int   @default(0)

  // §8.3 — consecutive years a religious member has had ZERO matching tags
  // with their religion's wanted_tags. At ≥5 they leave (auto-purge).
  unmatched_religion_years Int @default(0)
  // Same mechanic for factions — see `runUnmatchedTagPurgeTx`.
  unmatched_faction_years  Int @default(0)

  // Faction competition ledger. `faction_income_year` accumulates this year's
  // wealth-from-income for ranking purposes; reset to 0 at year-end after
  // awards. `faction_wins` / `faction_leadership_years` are career counters
  // for biography flavor + the Hall-of-Fame UI.
  faction_income_year       Int @default(0)
  faction_wins              Int @default(0)
  faction_leadership_years  Int @default(0)

  world             World     @relation(fields: [world_id], references: [id], onDelete: Cascade)
  city              City      @relation(fields: [city_id], references: [id])

  bonds_owned       Relationship[] @relation("RelationshipOwner")
  bonds_targeted    Relationship[] @relation("RelationshipTarget")
  decade_summaries  LifeDecadeSummary[]

  @@index([world_id, is_alive])
  @@index([world_id, city_id])
  @@index([world_id, faction_id])
  @@index([world_id, religion_id])
  @@index([is_pinned])
}

// ─── Relationship (§5.5) ─────────────────────────────────────────────────────

model Relationship {
  id          String   @id @default(uuid())
  owner_id    String
  target_id   String
  kind        String   // RelationshipKind: spouse|lover|rival|ally|nemesis
  strength    Int      // 0–100
  set_year    Int

  owner       Person   @relation("RelationshipOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  target      Person   @relation("RelationshipTarget", fields: [target_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, target_id, kind])
  @@index([owner_id])
  @@index([target_id])
}

// ─── Group (§8.1) ────────────────────────────────────────────────────────────

model Group {
  id                    String      @id @default(uuid())
  world_id              String
  kind                  GroupKind
  name                  String
  founder_id            String?
  leader_id             String?
  founded_year          Int
  dissolved_year        Int?
  is_active             Boolean     @default(true)
  treasury              Int         @default(0)
  member_count_cached   Int         @default(0)
  dominant_city_id      String?

  wanted_tags           Json        @default("[]")           // PersonalityTag[]
  type_affinities       Json        @default("{}")           // GroupTypeAffinities
  stat_floors           Json        @default("{}")           // GroupStatFloors
  cost_per_year         Int         @default(0)              // factions: flat coin/yr

  // Religion-only: dues are a fraction of each member's wealth instead of
  // a flat amount. Nullable so faction rows stay on cost_per_year. v1 default
  // 0.10 (10% of wealth). Range enforced 0.0–0.5 at the route layer.
  cost_pct_of_wealth    Float?

  // Faction-only (nullable for religions)
  territory_cities      Json        @default("[]")           // string[] of city ids
  tax_rate              Int?                                   // 0–50
  army_size             Int         @default(0)
  at_war_with           Json        @default("[]")           // string[] of group ids

  // Faction-only competition config (null for religions). v1 defaults:
  //   leader_dues_cut    = 0.10  → leader skims 10% of yearly dues
  //   prize_shares       = [0.15, 0.08, 0.04] → top 3 prize fractions of yearly dues
  //   competition_metric = 'income' (only metric supported in v1)
  //   intelligence_target = founder.intelligence at spawn (soft fit-bias)
  leader_dues_cut       Float?
  prize_shares          Json?
  competition_metric    String?
  intelligence_target   Float?

  // Lifecycle bookkeeping (§8.3)
  low_membership_years  Int         @default(0)
  last_schism_year      Int?

  // §16.1.4 — last-50-year member count history for the Group chart.
  // Shape: { year: number, real: number, bucket_share_total: number }[]
  member_count_history  Json        @default("[]")

  // Faction-only — last-N year-end awards plans (cap 10). Religions stay [].
  // Shape: FactionAwardHistoryEntry[] (see services/faction-awards.service.ts).
  award_history         Json        @default("[]")

  world                 World       @relation(fields: [world_id], references: [id], onDelete: Cascade)

  @@index([world_id, is_active])
  @@index([world_id, kind])
}

// ─── LifeDecadeSummary (§5.4) ────────────────────────────────────────────────

model LifeDecadeSummary {
  id                  String   @id @default(uuid())
  person_id           String
  decade_start_year   Int
  ranked_memories     Json     @default("[]")    // top memories of decade
  prior_summary_id    String?

  person              Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id, decade_start_year])
}

// ─── BiographyArchive (§10) ──────────────────────────────────────────────────

model BiographyArchive {
  id                  String   @id @default(uuid())
  world_id            String
  person_id           String   @unique
  name                String
  race                String
  age_at_demote       Int
  type                PersonType
  personality_tags    Json     @default("[]")
  state_tags          Json     @default("[]")
  wealth_at_demote    Int
  mother_id           String?
  father_id           String?
  spouse_id           String?
  faction_id          String?
  religion_id         String?
  top_memories        Json     @default("[]")    // top 5 memories at archive time
  was_criminal        Boolean  @default(false)
  demotion_reason     String                     // 'death' | 'demoted' | 'overflow'
  demote_year         Int

  world               World    @relation(fields: [world_id], references: [id], onDelete: Cascade)

  @@index([world_id])
}

// ─── WorldEvent (§9.4) ───────────────────────────────────────────────────────
// Single table — active when ended_year is null, archived when set.

model WorldEvent {
  id                       String          @id @default(uuid())
  world_id                 String
  event_def_id             EventType
  city_id                  String?         // city-scoped events
  faction_id               String?         // faction-scoped events
  started_year             Int
  ended_year               Int?
  end_reason               EventEndReason?
  duration_years           Int?            // null = condition-bound
  end_condition            Json?           // free-form predicate descriptor
  bucket_modifiers         Json            @default("[]")   // BucketModifier[]
  real_person_target_rules Json            @default("[]")   // RealPersonTargetRule[]
  cooldown_key             String?         // for cascade cooldown bookkeeping

  world                    World           @relation(fields: [world_id], references: [id], onDelete: Cascade)

  @@index([world_id, ended_year])
  @@index([world_id, event_def_id])
  @@index([world_id, city_id])
}

// ─── YearRun (§15.2 + §15.2.1) ───────────────────────────────────────────────

model YearRun {
  id              String         @id @default(uuid())
  world_id        String
  year            Int
  random_seed     BigInt
  status          YearRunStatus  @default(pending)
  started_at      DateTime?
  completed_at    DateTime?
  error_message   String?
  log             Json           @default("{}")     // engine-emitted breadcrumbs

  world           World          @relation(fields: [world_id], references: [id], onDelete: Cascade)

  @@unique([world_id, year])
  @@index([world_id, status])
}
